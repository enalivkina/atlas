{
  "name": "enalivkina/atlas",
  "autoload": {
    "psr-4": {
      "Atlas\\": ""
    }
  },
  "authors": [
    {
      "name": "e.nalivkina",
      "email": "e.nalivkina@efko.ru"
    }
  ],
  "require-dev": {
    "symfony/var-dumper": "^7.2",
    "codeception/codeception": "^5.3",
    "codeception/module-phpbrowser": "*",
    "codeception/module-asserts": "^3.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "require": {
    "psr/http-message": "^2.0",
    "psr/container": "^2.0",
    "ext-posix": "*",
    "ext-mbstring": "*",
    "firebase/php-jwt": "*",
    "ext-pdo": "*",
    "ext-pcntl": "*"
  },
  "scripts": {
    "test": "phpunit"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/tests/*",
      "/codeception.yml",
      ".gitignore",
      "/*.dist",
      "docker-compose.yml",
      "/.docker",
      "/.docker/*",
      "/.csFixer",
      "/.csFixer/*",
      "Makefile",
      ".gitattributes"
    ]
  }
}
